# Chemin secret du endpoint MCP
# Générer : python3 -c "import secrets; print('/mcp-'+secrets.token_urlsafe(12))"
MCP_SECRET_PATH=/mcp
HOST=0.0.0.0
PORT=8321
DB_PATH=data/amazon.db
# Cookies d'une session amazon.fr réelle (export navigateur au format JSON).
# Optionnel : améliore le taux de succès du scraping. Voir README.
COOKIES_PATH=data/cookies.json
CACHE_TTL_SECONDS=900
MIN_REQUEST_INTERVAL=3.0
TRACK_INTERVAL_HOURS=6
